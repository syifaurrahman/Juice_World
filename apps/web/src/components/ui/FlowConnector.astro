---
interface Props {
  step?: string;
  label?: string;
  hint?: string;
}

const { step, label, hint } = Astro.props;
---

<div class="relative flex flex-col items-center justify-center py-4 select-none pointer-events-none z-10">
  <!-- Top connecting line bridging from section above -->
  <div class="w-[2px] h-12 sm:h-16 bg-gradient-to-b from-transparent via-border to-accent/70"></div>

  <!-- Connected Central Node Badge -->
  {step && (
    <div class="my-1.5 flex flex-col items-center gap-1.5">
      <div class="group relative flex items-center gap-2.5 rounded-full border border-border/80 bg-background/95 px-5 py-2 shadow-sm backdrop-blur-md transition-all">
        <!-- Glowing station dot with animated ring -->
        <span class="relative flex size-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-75"></span>
          <span class="relative inline-flex size-2 rounded-full bg-accent"></span>
        </span>
        <span class="text-[10px] font-bold tracking-[0.25em] uppercase text-foreground">
          {step} {label && `· ${label}`}
        </span>
      </div>
      {hint && (
        <span class="text-[10px] tracking-wider text-muted-foreground/80 uppercase">
          {hint}
        </span>
      )}
    </div>
  )}

  {!step && (
    <div class="my-1 size-2 rounded-full bg-accent/70 ring-4 ring-accent/15"></div>
  )}

  <!-- Bottom connecting line bridging into section below -->
  <div class="w-[2px] h-12 sm:h-16 bg-gradient-to-b from-accent/70 via-border to-transparent"></div>
</div>
