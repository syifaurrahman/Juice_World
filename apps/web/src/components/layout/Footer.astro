---
const footerLinks = {
  produk: [
    { href: "/products?category=cold-pressed", label: "Cold Pressed" },
    { href: "/products?category=smoothie", label: "Smoothie" },
    { href: "/products?category=detox", label: "Detox" },
    { href: "/products?category=immunity", label: "Imunitas" },
  ],
  perusahaan: [
    { href: "/about", label: "Tentang Kami" },
    { href: "/reviews", label: "Ulasan" },
    { href: "/faq", label: "FAQ" },
    { href: "/contact", label: "Kontak" },
  ],
};
---

<footer id="kontak" class="bg-background pt-14 pb-12 border-t border-border/40">
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <!-- Bottom Footer Links -->
    <div class="grid grid-cols-1 gap-10 md:grid-cols-4 items-start pb-10 border-b border-border/40">
      <!-- Brand -->
      <div class="col-span-1 md:col-span-2 flex flex-col gap-3">
        <a href="/" class="font-heading text-3xl font-bold text-foreground tracking-tight">
          Juice World
        </a>
        <p class="text-xs text-muted-foreground leading-relaxed max-w-xs mt-1">
          Minuman sehat organik dari buah dan sayuran murni. Dibuat dengan cinta setiap hari untuk menjaga energi dan kebugaran tubuh Anda.
        </p>
        <!-- Social Media Links with Text -->
        <div class="flex flex-col gap-2 mt-3">
          <span class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground">
            Ikuti & Hubungi Kami
          </span>
          <div class="flex flex-wrap items-center gap-2">
            <!-- WhatsApp -->
            <a
              href="https://wa.me/6281234567890"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="WhatsApp Juice World"
              class="inline-flex items-center gap-1.5 rounded-full border border-border bg-secondary/50 px-3 py-1.5 text-xs font-medium text-foreground hover:bg-[#25D366] hover:text-white hover:border-[#25D366] transition-all shadow-xs"
            >
              <svg class="size-3.5" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.01-1.24-.74-.66-1.24-1.48-1.39-1.73-.14-.25-.02-.39.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.78 2.71 4.3 3.8.6.26 1.07.41 1.43.53.6.19 1.15.16 1.58.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.07-.1-.23-.17-.48-.29z"/>
              </svg>
              <span>WhatsApp</span>
            </a>

            <!-- Instagram -->
            <a
              href="https://instagram.com/juiceworld.id"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram Juice World"
              class="inline-flex items-center gap-1.5 rounded-full border border-border bg-secondary/50 px-3 py-1.5 text-xs font-medium text-foreground hover:bg-gradient-to-tr hover:from-amber-500 hover:via-rose-500 hover:to-purple-600 hover:text-white hover:border-transparent transition-all shadow-xs"
            >
              <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
              </svg>
              <span>Instagram</span>
            </a>

            <!-- TikTok -->
            <a
              href="https://tiktok.com/@juiceworld.id"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="TikTok Juice World"
              class="inline-flex items-center gap-1.5 rounded-full border border-border bg-secondary/50 px-3 py-1.5 text-xs font-medium text-foreground hover:bg-foreground hover:text-background transition-all shadow-xs"
            >
              <svg class="size-3.5" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
              </svg>
              <span>TikTok</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Links 1 -->
      <div class="flex flex-col gap-3">
        <h4 class="text-xs font-semibold uppercase tracking-widest text-foreground">Koleksi Rasa</h4>
        <ul class="flex flex-col gap-2">
          {footerLinks.produk.map(({ href, label }) => (
            <li>
              <a href={href} class="text-xs text-muted-foreground hover:text-foreground transition-colors">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Links 2 -->
      <div class="flex flex-col gap-3">
        <h4 class="text-xs font-semibold uppercase tracking-widest text-foreground">Informasi</h4>
        <ul class="flex flex-col gap-2">
          {footerLinks.perusahaan.map(({ href, label }) => (
            <li>
              <a href={href} class="text-xs text-muted-foreground hover:text-foreground transition-colors">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Copyright -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-8 text-xs text-muted-foreground">
      <p>&copy; {new Date().getFullYear()} Juicy (Juice World). Semua Hak Dilindungi.</p>
      <div class="flex gap-6">
        <a href="#" class="hover:text-foreground transition-colors">Privasi</a>
        <a href="#" class="hover:text-foreground transition-colors">Syarat & Ketentuan</a>
        <a href="#" class="hover:text-foreground transition-colors">Pengiriman</a>
      </div>
    </div>
  </div>
</footer>
