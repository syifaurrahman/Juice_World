---
import AnimatedContent from "../ui/AnimatedContent";

const heroGlassImg = "/images/hero-juice.webp";
---

<section id="hero" class="relative min-h-[85vh] overflow-hidden bg-background flex items-center">
  <!-- Top-left orange matte paint corner / lukisan cat doff mentok sudut -->
  <div
    class="pointer-events-none absolute -top-6 sm:-top-10 -left-6 sm:-left-10 z-0 w-36 sm:w-44 lg:w-52 h-36 sm:h-44 lg:h-52 select-none opacity-90"
    aria-hidden="true"
  >
    <svg viewBox="0 0 280 280" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full drop-shadow-[0_8px_20px_rgba(234,88,12,0.18)]">
      <defs>
        <!-- Matte paint gouache gradient: rich, flat, non-glossy -->
        <linearGradient id="matte-paint-tl" x1="40" y1="40" x2="240" y2="240" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#FB923C" />
          <stop offset="60%" stop-color="#F97316" />
          <stop offset="100%" stop-color="#EA580C" />
        </linearGradient>
      </defs>
      <!-- Hand-painted organic matte circle blob -->
      <path
        d="M140,24 C195,20 248,58 256,118 C264,178 228,236 172,254 C116,272 52,246 28,190 C4,134 22,64 76,34 C96,23 118,25 140,24 Z"
        fill="url(#matte-paint-tl)"
      />
      <!-- Natural paint splatter droplets -->
      <circle cx="260" cy="56" r="7" fill="#F97316" opacity="0.9" />
      <circle cx="272" cy="90" r="4.5" fill="#EA580C" opacity="0.8" />
      <circle cx="225" cy="22" r="5" fill="#FB923C" opacity="0.85" />
      <circle cx="238" cy="210" r="5.5" fill="#EA580C" opacity="0.85" />
      <circle cx="160" cy="268" r="4" fill="#F97316" opacity="0.75" />
      <circle cx="36" cy="245" r="5" fill="#EA580C" opacity="0.8" />
    </svg>
  </div>

  <!-- Bottom-right orange matte paint corner / lukisan cat doff mentok sudut -->
  <div
    class="pointer-events-none absolute -bottom-6 sm:-bottom-10 -right-6 sm:-right-10 z-0 w-36 sm:w-44 lg:w-52 h-36 sm:h-44 lg:h-52 select-none opacity-90"
    aria-hidden="true"
  >
    <svg viewBox="0 0 280 280" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full drop-shadow-[0_8px_20px_rgba(234,88,12,0.18)]">
      <defs>
        <!-- Matte paint gouache gradient -->
        <linearGradient id="matte-paint-br" x1="240" y1="240" x2="40" y2="40" gradientUnits="userSpaceOnUse">
          <stop offset="0%" stop-color="#C2410C" />
          <stop offset="50%" stop-color="#EA580C" />
          <stop offset="100%" stop-color="#F97316" />
        </linearGradient>
      </defs>
      <!-- Hand-painted organic matte circle blob -->
      <path
        d="M148,26 C202,30 252,72 258,130 C264,188 226,242 170,256 C114,270 48,244 24,192 C0,140 22,68 78,38 C98,27 122,25 148,26 Z"
        fill="url(#matte-paint-br)"
      />
      <!-- Natural paint splatter droplets -->
      <circle cx="58" cy="46" r="7.5" fill="#F97316" opacity="0.9" />
      <circle cx="34" cy="80" r="4.5" fill="#EA580C" opacity="0.85" />
      <circle cx="90" cy="22" r="4" fill="#FB923C" opacity="0.8" />
      <circle cx="262" cy="94" r="5" fill="#F97316" opacity="0.8" />
      <circle cx="230" cy="265" r="4.5" fill="#C2410C" opacity="0.85" />
    </svg>
  </div>

  <!-- Decorative organic blob background -->
  <div
    class="pointer-events-none absolute right-0 top-1/2 -translate-y-1/2 w-[52%] h-[88%] rounded-[40%_60%_60%_40%/40%_40%_60%_60%] bg-secondary opacity-80"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto max-w-7xl w-full px-6 lg:px-10 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-6 items-center">
      <!-- Left: Copy with AnimatedContent mount animation -->
      <AnimatedContent
        client:load
        trigger="mount"
        distance={35}
        direction="vertical"
        duration={0.9}
        ease="power3.out"
        className="flex flex-col gap-7 max-w-lg lg:col-span-5 z-10"
      >
        <!-- Label pill -->
        <div class="inline-flex w-fit items-center gap-2 rounded-full border border-border bg-secondary/60 px-4 py-1.5">
          <span class="size-1.5 rounded-full bg-accent"></span>
          <span class="text-xs font-medium tracking-widest text-muted-foreground uppercase">
            Organik · Segar · Alami
          </span>
        </div>

        <!-- Heading with brand styling -->
        <div class="flex flex-col gap-2">
          <h1 class="font-heading font-black leading-[0.95] text-foreground tracking-tight uppercase" style="font-size: clamp(3rem, 6vw, 4.8rem)">
            JUICE<br />
            <span class="text-accent">WORLD</span>
          </h1>
          <p class="font-bold text-xs sm:text-sm tracking-[0.25em] text-foreground/85 uppercase">
            JUICE.co
          </p>
        </div>

        <!-- Subtitle -->
        <p class="text-sm leading-relaxed text-muted-foreground max-w-xs">
          Jus cold-pressed premium dari buah-buahan organik pilihan. Tanpa pengawet, penuh nutrisi, siap menemani harimu.
        </p>

        <!-- CTA Row -->
        <div class="flex flex-wrap items-center gap-4 pt-1">
          <a
            href="/products"
            class="inline-flex h-12 items-center gap-2 rounded-full bg-foreground px-8 text-xs font-semibold tracking-widest text-background uppercase transition-all hover:bg-foreground/85 active:scale-[.98]"
          >
            Beli Sekarang
          </a>
          <a
            href="#flavors"
            class="inline-flex h-12 items-center gap-2 rounded-full border border-border bg-transparent px-6 text-xs font-semibold tracking-widest text-foreground uppercase transition-all hover:bg-muted"
          >
            Lihat Rasa
          </a>
        </div>

        <!-- Mini stats -->
        <div class="flex gap-8 pt-4 border-t border-border">
          <div>
            <p class="font-heading text-2xl font-bold text-foreground">100<span class="text-accent">%</span></p>
            <p class="text-xs text-muted-foreground mt-0.5">Organik</p>
          </div>
          <div>
            <p class="font-heading text-2xl font-bold text-foreground">0<span class="text-accent">g</span></p>
            <p class="text-xs text-muted-foreground mt-0.5">Pengawet</p>
          </div>
          <div>
            <p class="font-heading text-2xl font-bold text-foreground">8<span class="text-accent">+</span></p>
            <p class="text-xs text-muted-foreground mt-0.5">Varian Rasa</p>
          </div>
        </div>
      </AnimatedContent>

      <!-- Right: Free-floating product image with smooth horizontal entrance -->
      <AnimatedContent
        client:load
        trigger="mount"
        distance={45}
        direction="horizontal"
        delay={0.15}
        duration={1}
        ease="power3.out"
        className="relative flex items-center justify-end lg:col-span-7 -mr-6 sm:-mr-10 lg:-mr-[calc(max(0px,(100vw-80rem)/2)+1.25rem)] select-none"
      >
        <!-- Ambient glowing circles behind the image -->
        <div class="absolute right-4 top-1/2 -translate-y-1/2 size-96 lg:size-[600px] rounded-full bg-rose-200/35 blur-sm"></div>
        <div class="absolute -bottom-6 right-6 size-48 rounded-full bg-amber-200/30 blur-md"></div>

        <!-- Floating cutout image with soft drop shadow -->
        <img
          src={heroGlassImg}
          alt="Koleksi 4 varian jus segar Juice World dingin di atas es batu dengan irisan buah alami"
          class="relative z-10 w-full max-w-[620px] sm:max-w-[720px] lg:max-w-[800px] xl:max-w-[880px] 2xl:max-w-[960px] h-auto object-contain object-right drop-shadow-[0_20px_40px_rgba(40,15,10,0.18)] transition-transform duration-500 hover:scale-[1.03]"
          loading="eager"
          fetchpriority="high"
        />

        <!-- Floating badge: Best Seller -->
        <div class="absolute right-2 sm:right-6 lg:right-8 top-2 sm:top-4 z-20 flex flex-col items-center rounded-2xl border border-border/60 bg-background/95 p-3.5 shadow-lg backdrop-blur-md">
          <span class="text-[10px] font-semibold uppercase tracking-widest text-muted-foreground">Best</span>
          <span class="font-heading text-lg font-bold text-accent leading-none">Seller</span>
          <span class="mt-1 text-[9px] text-amber-500">★★★★★</span>
        </div>

        <!-- Floating badge: Price -->
        <div class="absolute left-0 sm:left-4 lg:left-6 bottom-4 sm:bottom-8 z-20 rounded-2xl border border-border/60 bg-background/95 p-3.5 shadow-lg backdrop-blur-md">
          <p class="text-[10px] font-medium text-muted-foreground">Mulai dari</p>
          <p class="font-heading text-xl font-bold text-foreground">Rp 38K</p>
        </div>
      </AnimatedContent>
    </div>
  </div>
</section>

<!-- Marquee ticker -->
<div class="overflow-hidden border-y border-border bg-foreground py-3">
  <div class="animate-marquee flex whitespace-nowrap">
    {Array.from({ length: 3 }).map(() => (
      <span class="flex items-center gap-6 px-4 text-xs font-semibold uppercase tracking-widest text-background">
        <span>✦ 100% Vegan</span>
        <span>✦ Certified Organic</span>
        <span>✦ Sugar Free</span>
        <span>✦ Gluten Free</span>
        <span>✦ No Preservatives</span>
        <span>✦ Cold-Pressed</span>
        <span>✦ Fresh Daily</span>
        <span>✦ Locally Sourced</span>
      </span>
    ))}
  </div>
</div>

<style>
  @keyframes marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-33.333%); }
  }
  .animate-marquee {
    animation: marquee 22s linear infinite;
  }
</style>
