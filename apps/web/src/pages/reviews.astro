---
import MainLayout from "../layouts/main.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import CartDrawer from "../components/cart/CartDrawer";
import ReviewsPageContent from "../components/reviews/ReviewsPageContent";
import AnimatedContent from "../components/ui/AnimatedContent";
---

<MainLayout title="Ulasan Pelanggan — Juice World" description="Baca cerita dan pengalaman nyata ribuan pelanggan yang telah menikmati kesegaran jus organik Juice World.">
  <Navbar />

  <main class="py-12 bg-background min-h-screen">
    <div class="mx-auto max-w-7xl px-6 lg:px-10">
      <AnimatedContent client:load distance={35} duration={0.8}>
        {/* Breadcrumb */}
        <nav class="flex items-center gap-2 text-xs text-muted-foreground mb-8">
          <a href="/" class="hover:text-foreground transition-colors">Beranda</a>
          <span>/</span>
          <span class="font-semibold text-foreground">Ulasan Pelanggan</span>
        </nav>

        {/* Header */}
        <div class="mb-12">
          <span class="text-xs font-semibold uppercase tracking-[0.25em] text-accent">— Suara Pelanggan —</span>
          <h1 class="mt-2 font-heading font-bold text-foreground" style="font-size: clamp(2.2rem, 4.5vw, 3.5rem)">
            Cerita & Ulasan Sehat
          </h1>
          <p class="max-w-xl text-sm text-muted-foreground leading-relaxed mt-2">
            Transparansi adalah prioritas kami. Semua ulasan di bawah ini ditulis langsung oleh pelanggan yang telah memesan dan menikmati produk Juice World.
          </p>
        </div>
      </AnimatedContent>

      {/* Interactive Reviews */}
      <ReviewsPageContent client:load />
    </div>
  </main>

  <Footer />
  <CartDrawer client:load />
</MainLayout>
